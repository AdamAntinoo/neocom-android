																					"isOrdered": false,
																					"isUnique": false,
																					"direction": "return"
																				}
																			],
																			"concurrency": "sequential",
																			"isQuery": false,
																			"isAbstract": false
																		}
																	],
																	"isAbstract": false,
																	"isFinalSpecialization": false,
																	"isLeaf": false,
																	"isActive": false
																},
																{
																	"_type": "UMLGeneralization",
																	"_id": "AAAAAAFkBNWq6uSVl5Y=",
