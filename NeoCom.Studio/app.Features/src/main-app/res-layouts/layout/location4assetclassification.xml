<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/uipanelborderorange">

    <include layout="@layout/nodebase_decorated" />

    <org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
        android:id="@+id/locationRegion"
        style="@style/AppTheme.TextView"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:layout_marginRight="2dp"
        android:gravity="right"
        android:text="@string/default_region"
        android:textColor="@color/appbluepurple"
        android:textSize="12sp" />

    <RelativeLayout
        android:id="@+id/dataBlock"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/rightBlock"
        android:layout_toRightOf="@+id/nodeIconBlock">

        <org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
            android:id="@+id/locationSystem"
            style="@style/AppTheme.NeoComText.Orange"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:text="Tash-Murkon - Moon 22"
            android:textSize="14sp" />

        <org.dimensinfin.android.mvc.fonts.ProximaNovaThinTextView
            android:id="@+id/locationIdentifier"
            style="@style/AppTheme.TextView"
            android:layout_alignBaseline="@+id/locationSystem"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="4dp"
            android:layout_toRightOf="@+id/locationSystem"
            android:text="[60014089]"
            android:textSize="12sp" />

        <RelativeLayout
            android:id="@+id/stationBlock"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/locationSystem">

            <org.dimensinfin.android.mvc.fonts.Din1451TextView
                android:id="@+id/locationSecurity"
                style="@style/AppTheme.Location"
                android:layout_alignBaseline="@+id/contentsCount"
                android:layout_alignParentLeft="true"
                android:layout_toLeftOf="@+id/childCount"
                android:text="@string/default_security"
                android:visibility="gone" />

            <org.dimensinfin.android.mvc.fonts.ProximaNovaRegularTextView
                android:id="@+id/locationStation"
                style="@style/AppTheme.Location"
                android:layout_alignParentLeft="true"
                android:layout_toLeftOf="@+id/contentsCount"
                android:text="@string/default_location" />

            <org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
                android:id="@+id/contentsCount"
                style="@style/AppTheme.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:minWidth="30dp"
                android:text="@string/default_locationitems"
                android:textColor="@color/appwhite"
                android:textSize="16sp" />
        </RelativeLayout>

        <org.dimensinfin.android.mvc.fonts.PrototypeTextView
            android:id="@+id/locationItemsValue"
            style="@style/AppTheme.TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/stationBlock"
            android:gravity="right"
            android:text="@string/default_isk"
            android:textSize="12sp"
            android:visibility="visible" />

        <org.dimensinfin.android.mvc.fonts.PrototypeTextView
            android:id="@+id/locationItemsVolume"
            style="@style/AppTheme.TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/stationBlock"
            android:gravity="right"
            android:text="@string/default_volume"
            android:textSize="12sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/locationItemsValueLabel"
            style="@style/AppTheme.Label.TopLine"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/locationItemsValue"
            android:text="CONTENTS MARKET VALUE"
            android:visibility="visible" />

        <TextView
            android:id="@+id/locationItemsVolumeLabel"
            style="@style/AppTheme.Label"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/locationItemsValue"
            android:text="CONTENTS VOLUME" />

        <RelativeLayout
            android:id="@+id/stationLabelBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/stationBlock"
            android:visibility="gone">

            <TextView
                android:id="@+id/locationLabel"
                style="@style/AppTheme.Label"
                android:layout_alignParentLeft="true"
                android:text="STATION" />

            <TextView
                android:id="@+id/childCountLabel"
                style="@style/AppTheme.Label"
                android:layout_alignParentRight="true"
                android:gravity="right"
                android:text="ITEMS" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/functionBlock"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/stationLabelBlock">

            <TextView
                android:id="@+id/role"
                style="@style/AppTheme.TextView"
                android:layout_width="wrap_content"
                android:layout_toLeftOf="@+id/functionLabel"
                android:gravity="right"
                android:text=" MANUFACTURE"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/functionLabel"
                style="@style/AppTheme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginLeft="2dp"
                android:text="ROLE"
                android:visibility="invisible" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/valueBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/stationLabelBlock">

            <LinearLayout
                android:id="@+id/valueLabelBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:layout_marginRight="90dp"
                android:orientation="vertical"
                android:visibility="gone">

                android:visibility="visible" /></LinearLayout>

            <LinearLayout
                android:id="@+id/valueDataBlock"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="false"
                android:layout_alignParentTop="true"
                android:layout_toLeftOf="@+id/valueLabelBlock"
                android:orientation="vertical"
                android:visibility="gone">


            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>
