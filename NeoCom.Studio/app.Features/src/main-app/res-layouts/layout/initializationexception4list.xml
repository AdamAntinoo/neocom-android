<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/uipanelborderwhite">

    <ImageView
        android:id="@+id/exceptionIcon"
        style="@style/AppTheme.NodeIcon"
        android:layout_width="@dimen/nodeiconsize"
        android:layout_height="@dimen/nodeiconsize"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:src="@drawable/outline_warning_black_18dp"
        android:tint="@color/appred"
        android:visibility="visible" />

    <org.dimensinfin.android.mvc.fonts.ProximaNovaRegularTextView
        android:id="@+id/message"
        style="@style/AppTheme.TextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/standardmargin"
        android:layout_marginTop="@dimen/standardmargin"
        android:layout_toRightOf="@+id/exceptionIcon"
        android:layout_below="@+id/exceptionClassName"
        android:text="@string/default_paneltitle"
        android:textSize="13sp" />

    <org.dimensinfin.android.mvc.fonts.ElementalEndTextView
        android:id="@+id/exceptionClassName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp"
        android:singleLine="true"
        android:text="EXCEPTION"
        android:textColor="@color/apporange"
        android:textSize="11sp"
        android:visibility="visible" />
</RelativeLayout>
