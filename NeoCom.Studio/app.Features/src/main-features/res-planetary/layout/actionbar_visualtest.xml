<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/activityIcon"
        android:layout_width="@dimen/nodeiconsize"
        android:layout_height="@dimen/nodeiconsize"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:src="@drawable/defaulticonplaceholder" />

    <org.dimensinfin.android.mvc.fonts.ElementalEndTextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@+id/activityIcon"
        android:layout_marginLeft="@dimen/standardmargin"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/appname"
        android:textColor="@color/apporange"
        android:textSize="16sp" />

    <org.dimensinfin.android.mvc.fonts.ProximaNovaThinTextView
        android:id="@+id/pageName"
        android:layout_width="wrap_content"
        android:layout_toRightOf="@+id/activityIcon"
        android:layout_height="wrap_content"
        android:layout_below="@+id/appName"
        android:layout_marginLeft="@dimen/standardmargin"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/servername"
        android:textColor="@color/appgreylight"
        android:textSize="11sp" />
</RelativeLayout>
