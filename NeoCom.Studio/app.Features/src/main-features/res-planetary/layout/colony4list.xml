<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nodeFrameContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/uipanelborderwhite">

    <FrameLayout
        android:id="@+id/planetIconBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/planetIcon"
            style="@style/AppTheme.NodeIcon"
            android:layout_width="@dimen/nodeiconsizebig"
            android:layout_height="@dimen/nodeiconsizebig"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true" />

        <FrameLayout
            android:id="@+id/colonyStorageCanvas"
            android:layout_width="@dimen/nodeiconsizebig"
            android:layout_height="@dimen/nodeiconsizebig"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true">

        </FrameLayout>

        <ImageView
            android:id="@+id/toprightDecorator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="right|top"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/hamburger_icon_white"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/topleftDecorator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="left|top"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="0dp"
            android:src="@drawable/xml_icon"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/bottomrightDecorator"
            android:layout_width="@dimen/halfnodeiconsize"
            android:layout_height="@dimen/halfnodeiconsize"
            android:layout_gravity="right|bottom"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/hamburger_icon_white"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/bottomleftDecorator"
            android:layout_width="@dimen/halfnodeiconsize"
            android:layout_height="@dimen/halfnodeiconsize"
            android:layout_gravity="left|bottom"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="0dp"
            android:src="@drawable/xml_icon"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/rightBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/separator"
            android:layout_width="@dimen/standardmargin"
            android:layout_height="match_parent"
            android:src="@android:color/transparent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/actuatorsBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/rightArrow"
                style="@style/AppTheme.Arrow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:layout_marginTop="-5dp"
                android:src="@drawable/hamburger_icon_white"
                android:visibility="visible" />

        </LinearLayout>
    </LinearLayout>

    <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
        android:id="@+id/solarSystemName"
        style="@style/AppTheme.NeoComText.Planetary.SystemName"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@+id/planetIconBlock" />

    <org.dimensinfin.android.mvc.fonts.Din1451TextView
        android:id="@+id/constellationName"
        style="@style/AppTheme.NeoComText.Planetary.ConstellationName"
        android:layout_alignBaseline="@+id/solarSystemName"
        android:layout_marginLeft="@dimen/standardmargin"
        android:layout_toRightOf="@+id/solarSystemName" />

    <org.dimensinfin.android.mvc.fonts.PrototypeTextView
        android:id="@+id/installationsNumber"
        style="@style/AppTheme.NeoComText.Planetary.Number"
        android:layout_below="@+id/solarSystemName"
        android:layout_toRightOf="@+id/planetIconBlock" />

    <org.dimensinfin.android.mvc.fonts.Din1451TextView
        android:id="@+id/installationsLabel"
        style="@style/AppTheme.NeoComText.Planetary.Label"
        android:layout_alignBaseline="@+id/installationsNumber"
        android:layout_marginLeft="@dimen/uilefttextmargin"
        android:layout_toRightOf="@+id/installationsNumber"
        android:text="Installations" />

    <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
        android:id="@+id/planetType"
        style="@style/AppTheme.NodeClass"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/rightBlock"
        android:text="@string/default_planettype" />

    <LinearLayout
        android:id="@+id/storageUsedBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/installationsNumber"
        android:layout_toRightOf="@+id/planetIconBlock"
        android:orientation="horizontal"
        android:visibility="visible">

        <ImageView
            android:id="@+id/storageIcon"
            style="@style/AppTheme.NodeIcon.NoBorder"
            android:layout_width="@dimen/halfnodeiconsize"
            android:layout_height="@dimen/halfnodeiconsize"
            android:src="@drawable/storage80_white"
            android:visibility="visible" />

        <org.dimensinfin.android.mvc.fonts.PrototypeTextView
            android:id="@+id/storageUsed"
            style="@style/AppTheme.StockCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/uilefttextmargin"
            android:layout_marginTop="3dip"
            android:gravity="right"
            android:text="1.345 m3/12.500 m3"
            android:textSize="14sp" />
    </LinearLayout>

    <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
        android:id="@+id/storageUsedLabel"
        style="@style/AppTheme.Label.TopLine"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/storageUsedBlock"
        android:layout_marginLeft="@dimen/halfnodeiconsize"
        android:layout_marginRight="32dp"
        android:layout_toRightOf="@+id/planetIconBlock"
        android:text="Total Storage in use" />

    <LinearLayout
        android:id="@+id/resourcesValueBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/storageUsedLabel"
        android:layout_toRightOf="@+id/planetIconBlock"
        android:orientation="horizontal"
        android:visibility="visible">

        <ImageView
            android:id="@+id/walletIcon"
            style="@style/AppTheme.NodeIcon.NoBorder"
            android:layout_width="@dimen/halfnodeiconsize"
            android:layout_height="@dimen/halfnodeiconsize"
            android:src="@drawable/wallet"
            android:visibility="visible" />

        <org.dimensinfin.android.mvc.fonts.PrototypeTextView
            android:id="@+id/resourcesMarketValue"
            style="@style/AppTheme.ISKAmount"
            android:layout_marginLeft="@dimen/standardmargin"
            android:textSize="14sp" />

    </LinearLayout>

    <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
        android:id="@+id/resourcesValueLabel"
        style="@style/AppTheme.Label.TopLine"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/resourcesValueBlock"
        android:layout_marginLeft="@dimen/halfnodeiconsize"
        android:layout_marginRight="32dp"
        android:layout_toRightOf="@+id/planetIconBlock"
        android:text="Total Resources market value" />
</RelativeLayout>
