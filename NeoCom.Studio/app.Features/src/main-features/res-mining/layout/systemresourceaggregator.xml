<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/darkbluetranslucent80"
    android:orientation="horizontal">

    <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
        android:id="@+id/systemName"
        style="@style/AppTheme.TextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/standardmargin"
        android:layout_marginTop="@dimen/standardmargin"
        android:text="@string/default_paneltitle"
        android:textSize="12sp" />

    <org.dimensinfin.android.mvc.fonts.PrototypeTextView
        android:id="@+id/extractionValue"
        style="@style/AppTheme.TextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_marginTop="@dimen/standardmargin"
        android:gravity="right"
        android:text="@string/default_paneltitle"
        android:textSize="12sp" />
</RelativeLayout>
