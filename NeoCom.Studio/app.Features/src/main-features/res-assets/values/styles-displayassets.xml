<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="expandable">#FF6CC417</color>

    <!-- R E G I O N -->
    <style name="AppTheme.Region.Icon" parent="AppTheme.NodeIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginLeft">@dimen/standardmargin</item>
    </style>

    <style name="AppTheme.Region.Name" parent="AppTheme.NeoComText">
        <item name="android:singleLine">true</item>
        <item name="android:visibility">visible</item>
        <item name="android:textColor">@color/expandable</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_marginLeft">@dimen/standardmargin</item>
    </style>
    <style name="AppTheme.Region.Counts" parent="AppTheme.NeoComText">
        <item name="android:gravity">right</item>
    </style>
</resources>
