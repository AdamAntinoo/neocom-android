<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panelborderorange" >

    <ImageView
        android:id="@+id/pilotAvatar"
        style="@style/ItemIconStyle.Size32"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_margin="2dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/whiteborderbox"
        android:contentDescription="Item Icon"
        android:src="@drawable/nopilot" />

    <ImageView
        android:id="@+id/separator"
        android:layout_width="10dp"
        android:layout_height="1dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/rightArrow"
        android:src="@color/panelbackgroundblack"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/rightArrow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_gravity="right"
        android:gravity="right"
        android:padding="-4dp"
        android:src="@drawable/arrowdown"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pilotInformationBlock"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/pilotRaceBlock"
        android:layout_toRightOf="@+id/pilotAvatar"
        android:orientation="vertical" >

        <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
            android:id="@+id/pilotName"
            style="@style/NameStyle.Green"
            android:text="Adam Antinoo" />

        <RelativeLayout
            android:id="@+id/secondaryDataBlock"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" >

            <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
                android:id="@+id/accountBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:text="123,345,556.98 ISK"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
                android:id="@+id/assetsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:ellipsize="marquee"
                android:gravity="right"
                android:singleLine="true"
                android:text="125 items"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/secondaryLabelBlock"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" >

            <TextView
                android:id="@+id/accountBalanceLabel"
                style="@style/Label.Style.TopLine"
                android:layout_alignParentLeft="true"
                android:gravity="left"
                android:text="BALANCE" />

            <TextView
                android:id="@+id/assetsCountLabel"
                style="@style/Label.Style"
                android:layout_alignParentRight="true"
                android:gravity="right"
                android:text="ASSETS" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pilotRaceBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="5dp"
        android:layout_toLeftOf="@+id/separator"
        android:gravity="right"
        android:orientation="vertical"
        android:visibility="visible" >

        <org.dimensinfin.eveonline.neocom.core.MonsOlympia
            android:id="@+id/characterClass"
            style="@style/Name.Style.11"
            android:layout_alignParentRight="true"
            android:gravity="right"
            android:text="PILOT"
            android:textColor="#FF0000FF" />

        <org.dimensinfin.eveonline.neocom.core.MonsOlympia
            android:id="@+id/race"
            style="@style/Name.Style.10"
            android:layout_alignParentRight="true"
            android:layout_marginTop="-4dp"
            android:gravity="right"
            android:text="Minmatar"
            android:textColor="#FF337AB7" />

        <org.dimensinfin.eveonline.neocom.core.MonsOlympia
            android:id="@+id/cloneType"
            style="@style/Name.Style.10"
            android:layout_alignParentRight="true"
            android:layout_marginTop="-4dp"
            android:gravity="right"
            android:singleLine="false"
            android:text="Clone Grade Alpha"
            android:textColor="@color/apporangemedium" />

        <org.dimensinfin.eveonline.neocom.core.MonsOlympia
            android:id="@+id/expirationTime"
            style="@style/Name.Style.10"
            android:layout_alignParentRight="true"
            android:layout_marginTop="-4dp"
            android:gravity="right"
            android:singleLine="false"
            android:text="Expired"
            android:textColor="@color/appred"
            android:visibility="visible" />
    </LinearLayout>

</RelativeLayout>