<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="@android:style/Theme.Holo">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:actionBarStyle">@style/NeoComActionBar</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>|
    </style>

    <style name="NeoComActionBar" parent="@android:style/Widget.Holo.ActionBar">
        <item name="android:background">@android:color/black</item>
        <item name="android:titleTextStyle">@style/AppTheme.ActionBar.TitleTextStyle</item>
    </style>

    <style name="AppTheme.ActionBar.TitleTextStyle" parent="@android:style/TextAppearance.Holo.Widget.ActionBar.Title">
        <item name="android:textColor">@color/appwhite</item>
        <item name="android:textStyle">bold</item>
        <!--<item name="android:shadowColor">@color/appwhite</item>-->
        <!--<item name="android:shadowDx">0</item>-->
        <!--<item name="android:shadowDy">0</item>-->
        <!--<item name="android:shadowRadius">10</item>-->
    </style>

    <style name="AppTheme.PrefCatStyle" parent="@android:style/Theme.Holo">
        <item name="android:textColor">@color/apporange</item>
        <item name="android:background">@color/appgreydark</item>
    </style>

    <style name="AppTheme.ActionBarActivityIcon">
        <item name="android:layout_width">@dimen/nodeiconsize</item>
        <item name="android:layout_height">@dimen/nodeiconsize</item>
        <item name="android:contentDescription">@string/default_content_description</item>
        <item name="android:src">@drawable/defaulticonplaceholder</item>
         <item name="android:layout_marginRight">@dimen/standardmargin</item>
        <item name="android:layout_marginLeft">@dimen/standardmargin</item>
        <item name="android:layout_marginBottom">@dimen/standardmargin</item>
        <item name="android:layout_marginTop">@dimen/standardmargin</item>
        <item name="android:background">#00000000</item>
    </style>

    <style name="AppTheme.PilotAvatar">
        <item name="android:layout_width">@dimen/pilotavatarsize</item>
        <item name="android:layout_height">@dimen/pilotavatarsize</item>
        <item name="android:contentDescription">@string/default_content_description</item>
        <item name="android:src">@drawable/defaulticonplaceholder</item>
        <item name="android:layout_alignParentLeft">true</item>
        <item name="android:layout_alignParentTop">true</item>
        <item name="android:layout_marginRight">3dp</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/whiteborderbox</item>
    </style>

    <style name="AppTheme.StockCounter" parent="AppTheme.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/appwhite</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">right</item>
        <item name="android:text">@string/default_stocknumber</item>
    </style>

    <style name="AppTheme.NeoComText.Orange" parent="AppTheme.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/apporange</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppTheme.NeoComText.Green" parent="AppTheme.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/appgreen</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppTheme.Location">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:singleLine">false</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!--<style name="AppTheme.Location.Role">-->
        <!--<item name="android:background">@drawable/blueroundedbox</item>-->
        <!--<item name="android:ellipsize">marquee</item>-->
        <!--<item name="android:paddingLeft">5dp</item>-->
        <!--<item name="android:paddingRight">5dp</item>-->
        <!--<item name="android:singleLine">true</item>-->
        <!--<item name="android:textSize">10sp</item>-->
    <!--</style>-->

    <style name="AppTheme.NodeClass.NeoCom">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/appblue</item>
        <item name="android:gravity">right</item>
        <item name="android:textSize">9sp</item>
    </style>
    <style name="Widget.ProgressBar.Vertical">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/vertical_progressbar</item>
        <item name="android:indeterminateDrawable">@android:drawable/progress_indeterminate_horizontal</item>
        <item name="android:minWidth">1dip</item>
        <item name="android:maxWidth">12dip</item>
    </style>
    <style name="AppTheme.SkillBlock">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">7dp</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:layout_marginLeft">0dp</item>
        <item name="android:layout_marginRight">1dp</item>
        <item name="android:layout_marginTop">1dp</item>
    </style>

</resources>
