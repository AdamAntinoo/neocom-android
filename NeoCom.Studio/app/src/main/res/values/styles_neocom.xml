<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ItemIcon">
        <item name="android:layout_width">@dimen/itemIcon48</item>
        <item name="android:layout_height">@dimen/itemIcon48</item>
        <item name="android:contentDescription">@string/imageview_defaultcontent</item>
        <item name="android:src">@drawable/defaultitemicon</item>
    </style>
    <style name="ItemIcon.Style">
        <item name="android:layout_width">@dimen/itemIcon48</item>
        <item name="android:layout_height">@dimen/itemIcon48</item>
        <item name="android:layout_alignParentLeft">true</item>
        <item name="android:layout_alignParentTop">true</item>
        <item name="android:layout_marginRight">3dp</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/whiteborderbox</item>
    </style>
    <style name="ItemIcon.Style.Size32" parent="ItemIcon.Style">
        <item name="android:layout_width">@dimen/itemIcon32</item>
        <item name="android:layout_height">@dimen/itemIcon32</item>
    </style>

    <style name="Name">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:singleLine">false</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Name.Style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- NeoCom Specific items styles. -->
    <style name="Location">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:singleLine">false</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Location.Style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Location.Style.AssetList">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Label">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">8sp</item>
    </style>

    <style name="Label.Style">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">7sp</item>
    </style>

    <style name="Label.Style.BottomLine">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bottomwhiteline</item>
    </style>

    <style name="Label.Style.TopLine">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/topwhiteline</item>
    </style>

</resources>
