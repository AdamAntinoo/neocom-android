<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panelborderyellow" >

    <ImageView
        android:id="@+id/assetIcon"
        style="@style/ItemIcon.Style.Size32"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_margin="2dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/whiteborderbox"
        android:contentDescription="Item Icon"
        android:src="@drawable/defaultitemicon" />

    <ImageView
        android:id="@+id/separator"
        android:layout_width="10dp"
        android:layout_height="1dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/rightArrow"
        android:src="@color/panelbackgroundblack"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/rightArrow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_gravity="right"
        android:gravity="right"
        android:padding="-4dp"
        android:src="@drawable/arrowleft"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/assetInformationBlock"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/separator"
        android:layout_toRightOf="@+id/assetIcon"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/assetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="@string/default_bponame"
            android:textColor="@color/apporange"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/assetCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/assetName"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="Mineral - Asteroid"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/itemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/assetCategory"
            android:layout_toLeftOf="@+id/stackValue"
            android:ellipsize="marquee"
            android:gravity="left"
            android:text="123,456.65 ISK"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/stackValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/assetCategory"
            android:ellipsize="marquee"
            android:gravity="right"
            android:singleLine="true"
            android:text="123,456.65 ISK"
            android:textColor="@android:color/white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/valueLabel"
            style="@style/Label.Style.TopLine"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/stackValue"
            android:gravity="right"
            android:text="STACK VALUE" />

        <LinearLayout
            android:id="@+id/qtyBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/count"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="@string/default_smallnumber"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/countLabel"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/topwhiteline"
                android:ellipsize="marquee"
                android:gravity="right"
                android:singleLine="true"
                android:text="NO. ITEMS"
                android:textColor="@android:color/white"
                android:textSize="7sp" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
