<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/blacktraslucent80">

    <FrameLayout
        android:id="@+id/nodeIconBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/nodeIcon"
            style="@style/AppTheme.NodeIcon"
            android:layout_width="@dimen/nodeiconsizesmall"
            android:layout_height="@dimen/nodeiconsizesmall"
            android:src="@drawable/defaulticonplaceholder"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/toprightDecorator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="right|top"
            android:layout_marginBottom="2dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/hamburger_icon_white"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/topleftDecorator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="left|top"
            android:layout_marginBottom="0dp"
            android:layout_marginLeft="2dp"
            android:src="@drawable/techiiicon"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/bottomrightDecorator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="right|bottom"
            android:layout_marginBottom="2dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/hamburger_icon_white"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/bottomleftDecorator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="left|bottom"
            android:layout_marginBottom="0dp"
            android:layout_marginLeft="2dp"
            android:src="@drawable/xml_icon"
            android:visibility="invisible" />
    </FrameLayout>

    <org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
        android:id="@+id/title"
        style="@style/AppTheme.NeoComText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/nodeIconBlock"
        android:text="@string/default_paneltitle" />

    <org.dimensinfin.android.mvc.fonts.PrototypeTextView
        android:id="@+id/count"
        style="@style/AppTheme.NeoComText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/rightBlock"
        android:gravity="right"
        android:text="@string/default_quantity" />

    <LinearLayout
        android:id="@+id/rightBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/separator"
            android:layout_width="@dimen/standardmargin"
            android:layout_height="match_parent"
            android:src="@android:color/transparent"
            android:visibility="visible" />
    </LinearLayout>
</RelativeLayout>
