<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/blacktraslucent80"
    android:orientation="horizontal">

    <org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
            android:id="@+id/title"
            style="@style/AppTheme.TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/standardmargin"
            android:layout_centerVertical="true"
            android:text="@string/default_paneltitle"
            android:textSize="12sp" />
    <org.dimensinfin.android.mvc.fonts.PrototypeTextView
            android:id="@+id/volume"
            style="@style/AppTheme.TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:gravity="right"
            android:layout_marginLeft="@dimen/standardmargin"
            android:text="@string/default_volume"
            android:textSize="12sp" />
</RelativeLayout>
