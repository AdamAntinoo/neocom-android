<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/uipanelborderdarkblue">

	<org.dimensinfin.android.mvc.fonts.ProximaNovaRegularTextView
			android:id="@+id/taskName"
			style="@style/AppTheme.TextView"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="@dimen/standardmargin"
			android:layout_marginTop="@dimen/standardmargin"
			android:text="@string/default_paneltitle"
			android:textSize="12sp"/>


	<org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
			android:id="@+id/status"
			style="@style/AppTheme.NeoComText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_toStartOf="@+id/elapsedTime"
			android:layout_marginEnd="4dp"
			android:gravity="right"
			android:textColor="@color/appgreylight"
			android:layout_marginStart="@dimen/standardmargin"
			android:layout_marginTop="@dimen/standardmargin"
			android:text="@string/default_paneltitle"
			android:textSize="12sp"/>

	<org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
			android:id="@+id/elapsedTime"
			style="@style/AppTheme.NeoComText.ElapsedTime"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_toStartOf="@+id/spinnerOn"
			android:layout_marginEnd="4dp"
			android:gravity="right"
			android:layout_marginStart="@dimen/standardmargin"
			android:layout_marginTop="@dimen/standardmargin"
			android:text="-"
			android:textSize="12sp"/>

	<ImageView
			android:id="@+id/spinnerOn"
			style="@style/AppTheme.NodeIcon.NoBorder"
			android:layout_width="18dp"
			android:layout_height="18dp"
			android:layout_alignParentEnd="true"
			android:src="@drawable/progress_spinner_white"
			android:visibility="visible"/>

	<ImageView
			android:id="@+id/spinnerOff"
			style="@style/AppTheme.NodeIcon.NoBorder"
			android:layout_width="18dp"
			android:layout_height="18dp"
			android:layout_alignParentEnd="true"
			android:src="@drawable/progress70_white"
			android:visibility="invisible"/>

</RelativeLayout>
