<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
             android:id="@+id/mapCanvas"
             android:layout_width="match_parent"
             android:layout_height="match_parent">

    <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" tools:srcCompat="@tools:sample/avatars[1]"
            android:id="@+id/imageView"/>
    <org.dimensinfin.android.mvc.fonts.Din1451TextView
            android:id="@+id/structureName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp"
            android:layout_marginTop="1dp"
            android:background="@android:color/transparent"
            android:paddingBottom="2dp"
            android:paddingLeft="2dp"
            android:text="EXTRACTORS"
            android:textColor="@color/apporange"
            android:textSize="13sp"
            android:textStyle="bold" />
</FrameLayout>
