<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:id="@+id/nodeIconBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/nodeIcon"
            style="@style/AppTheme.NodeIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/defaulticonplaceholder"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/toprightDecorator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="right|top"
            android:layout_marginBottom="2dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/hamburger_icon_white"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/topleftDecorator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="left|top"
            android:layout_marginBottom="0dp"
            android:layout_marginLeft="2dp"
            android:src="@drawable/techiiicon"
            android:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/rightBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/separator"
            android:layout_width="@dimen/standardmargin"
            android:layout_height="match_parent"
            android:src="@android:color/transparent"
            android:visibility="visible" />
    </LinearLayout>
</merge>
