<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:id="@+id/nodeIconBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/nodeIcon"
            style="@style/AppTheme.NodeIcon"
            android:layout_width="@dimen/nodeiconsizesmall"
            android:layout_height="@dimen/nodeiconsizesmall"
            android:src="@drawable/defaulticonplaceholder"
            android:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/rightBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/separator"
            android:layout_width="@dimen/standardmargin"
            android:layout_height="match_parent"
            android:src="@android:color/transparent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/actuatorsBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/rightArrow"
                style="@style/AppTheme.Arrow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="-5dp"
                android:layout_gravity="center"
                android:src="@drawable/hamburger_icon_white"
                android:visibility="visible" />

        </LinearLayout>
    </LinearLayout>
</merge>
