<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="org.dimensinfin.eveonline.neocom">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-sdk
        android:minSdkVersion="16"
        android:targetSdkVersion="27" />

    <application
        android:name="NeoComApplication"
        android:allowBackup="true"
        android:description="@string/AppDescription"
        android:icon="@drawable/neocom_icon"
        android:label="@string/appnameversion"
        android:largeHeap="true"
        android:logo="@drawable/neocom_icon"
        android:roundIcon="@drawable/neocom_icon"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar"
        tools:replace="android:label">

        <!-- S T A R T U P    A C T I V I T Y -->
        <activity
            android:name=".activity.AppDashboardActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:icon="@drawable/splash_icon"
            android:label="@string/appnameversion"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A C T I V I T I E S -->
        <activity
            android:name=".activity.core.SettingsActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="Settings">
        </activity>
        <activity
            android:name=".activity.AuthorizationFlowActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="Authorization ESI Flow"
            android:parentActivityName=".activity.AppDashboardActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="esiauthentication"
                    android:scheme="eveauth-neocom" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.PilotDashboardActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="Pilot Dashboard">
        </activity>
        <activity
            android:name=".activity.AssetsManagerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="Assets Manager">
            <meta-data
                android:name="android.app.default_searchable"
                android:value=".activity.SearchAssetsActivity" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.MiningLedgerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="Mining Ledger">
        </activity>
        <activity
            android:name=".activity.RefiningDetailActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="Mining Ledger"
            android:screenOrientation="landscape">

        </activity>
        <activity
            android:name=".activity.SkillsManagerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="Skills Manager">
        </activity>



