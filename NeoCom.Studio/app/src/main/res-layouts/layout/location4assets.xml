<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panelborderorange" >

    <include layout="@layout/nodebase4expand" />

    <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
        android:id="@+id/locationRegion"
        style="@style/AppTheme.NeoComText.Orange"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:gravity="right"
        android:text="@string/default_region"
        android:textSize="12sp" />

    <RelativeLayout
        android:id="@+id/dataBlock"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/rightArrow"
        android:layout_toRightOf="@+id/nodeIcon" >

        <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
            android:id="@+id/locationSystem"
            style="@style/AppTheme.TextView"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:textSize="14sp"
            android:text="Tash-Murkon - Moon 22" />

        <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
            android:id="@+id/locationIdentifier"
            style="@style/AppTheme.TextView"
            android:textSize="11sp"
            android:layout_alignBaseline="@+id/locationSystem"
            android:layout_alignParentTop="true"
            android:layout_toRightOf="@+id/locationSystem"
            android:text="[60014089]" />

        <RelativeLayout
            android:id="@+id/stationBlock"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/locationSystem"
            android:background="@drawable/bottomwhiteline" >

            <org.dimensinfin.android.mvc.fonts.Din1451TextView
                android:id="@+id/locationStation"
                style="@style/AppTheme.Location"
                android:layout_alignBaseline="@+id/childCount"
                android:layout_alignParentLeft="true"
                android:layout_toLeftOf="@+id/childCount"
                android:text="@string/default_location" />

            <org.dimensinfin.android.mvc.fonts.Din1451TextView
                android:id="@+id/childCount"
                style="@style/AppTheme.TextView"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:minWidth="30dp"
                android:text="@string/default_smallnumber"
                android:textColor="@android:color/white" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/stationLabelBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/stationBlock" >

            <TextView
                android:id="@+id/locationLabel"
                style="@style/AppTheme.Label"
                android:layout_alignParentLeft="true"
                android:text="STATION" />

            <TextView
                android:id="@+id/childCountLabel"
                style="@style/AppTheme.Label"
                android:layout_alignParentRight="true"
                android:gravity="right"
                android:text="ITEMS" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/functionBlock"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/stationLabelBlock" >

            <TextView
                android:id="@+id/role"
                style="@style/AppTheme.Location.Role"
                android:layout_width="wrap_content"
                android:layout_toLeftOf="@+id/functionLabel"
                android:gravity="right"
                android:text=" MANUFACTURE"
                android:visibility="visible" />

            <TextView
                android:id="@+id/functionLabel"
                style="@style/AppTheme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginLeft="2dp"
                android:text="ROLE" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/valueBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/functionBlock" >

            <LinearLayout
                android:id="@+id/valueLabelBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:layout_marginRight="90dp"
                android:orientation="vertical"
                android:visibility="gone" >

                <org.dimensinfin.eveonline.neocom.core.Din1451TextView
                    android:id="@+id/locationItemsValueLabel"
                    style="@style/AppTheme.TextView"
                    android:gravity="left"
                    android:textSize="10sp"
                    android:text="ISK"
                    android:visibility="visible" />

                <org.dimensinfin.eveonline.neocom.core.Din1451TextView
                    android:id="@+id/locationItemsVolumeLabel"
                    style="@style/AppTheme.TextView"
                    android:gravity="left"
                    android:text="m3"
                    android:textSize="10sp"
                    android:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/valueDataBlock"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="false"
                android:layout_alignParentTop="true"
                android:layout_toLeftOf="@+id/valueLabelBlock"
                android:orientation="vertical"
                android:visibility="gone" >

                <org.dimensinfin.android.mvc.fonts.Din1451TextView
                    android:id="@+id/locationItemsValue"
                    style="@style/AppTheme.TextView"
                    android:layout_width="fill_parent"
                    android:textSize="12sp"
                    android:layout_marginRight="3dp"
                    android:gravity="right"
                    android:text="-"
                    android:visibility="visible" />

                <org.dimensinfin.android.mvc.fonts.Din1451TextView
                    android:id="@+id/locationItemsVolume"
                    style="@style/AppTheme.TextView"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:layout_marginRight="3dp"
                    android:gravity="right"
                    android:text="-"
                    android:visibility="visible" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>
