<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background="@drawable/panelbordergreen">

    <ImageView
        android:id="@+id/pilotAvatar"
        android:layout_width="@dimen/pilotavatarsize"
        android:layout_height="@dimen/pilotavatarsize"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_margin="2dp"
        android:contentDescription="Character avatar"
        android:src="@drawable/nopilot" />

    <LinearLayout
        android:id="@+id/pilotInformationBlock"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@+id/pilotAvatar"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/pilotIdentificationBlock"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_toRightOf="@+id/pilotAvatar"
            android:orientation="horizontal">

            <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
                android:id="@+id/pilotName"
                style="@style/AppTheme.NeoComText.Orange"
                android:text="Adam Antinoo" />

            <org.dimensinfin.android.mvc.fonts.ElementalEndTextView
                android:id="@+id/characterId"
                style="@style/AppTheme.TextView"
                android:layout_marginLeft="3dp"
                android:text="[9863234]"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lastKnownLocation"
            style="@style/AppTheme.TextView"
            android:singleLine="false"
            android:text=">>> Goni VII - Transtellar Shipping &lt;&lt;&lt;"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lastKnownLocationLabel"
            style="@style/AppTheme.Label"
            android:layout_width="fill_parent"
            android:background="@drawable/topwhiteline"
            android:text="LAST KNOWN LOCATION" />

        <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
            android:id="@+id/accountBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="123,345,556.98 ISK"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/accountBalanceLabel"
            style="@style/AppTheme.Label.TopLine"
            android:gravity="left"
            android:text="BALANCE" />

        <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
            android:id="@+id/assetsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="125 items"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/assetsCountLabel"
            style="@style/AppTheme.Label.TopLine"
            android:text="ASSET COUNT" />
    </LinearLayout>

</RelativeLayout>
