<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/uipanelborderwhite">

    <ImageView
        android:id="@+id/sectionIcon"
        style="@style/AppTheme.PilotSection.Icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="@dimen/standardmargin"
        android:src="@drawable/wallet" />

    <RelativeLayout
        android:id="@+id/pilotSectionBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/standardmargin"
        android:layout_marginRight="@dimen/standardmargin"
        android:layout_marginTop="@dimen/standardmargin"
        android:layout_toRightOf="@+id/sectionIcon">

        <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
            android:id="@+id/sectionTitle"
            style="@style/AppTheme.PilotSection.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WALLET" />

        <org.dimensinfin.android.mvc.fonts.PrototypeTextView
            android:id="@+id/sectionData"
            style="@style/AppTheme.PilotSection.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/clickBlock"
            android:text="@string/default_skillpoints" />

        <TextView
            android:id="@+id/sectionLabel"
            style="@style/AppTheme.Label.TopLine"
            android:layout_below="@+id/sectionData"
            android:layout_toLeftOf="@+id/clickBlock"
            android:gravity="right"
            android:text="WALLET AMOUNT" />

        <LinearLayout
            android:id="@+id/clickBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/clickIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="@dimen/standardmargin"
                android:src="@drawable/multiarrowright" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
