<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/uipanelbordergreen">

    <include layout="@layout/nodebase_decoratedicon_small" />

    <LinearLayout
        android:id="@+id/inTrainingProgressBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/skillLevelsGroup"
        android:layout_marginBottom="1dp"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="5dp"
        android:visibility="gone"
        android:layout_toLeftOf="@+id/rightBlock"
        android:background="@drawable/whiteborderbox"
        android:orientation="horizontal"
        android:padding="1dp">

        <ProgressBar
            android:id="@+id/trainedProgress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="74dp"
            android:layout_height="6dp"
            android:layout_margin="1dp"
            android:progressDrawable="@color/blueDarkProgress"
            android:visibility="visible" />
    </LinearLayout>

    <org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
        android:id="@+id/skillName"
        style="@style/AppTheme.NeoComText.Hover"
        android:layout_alignParentTop="true"
        android:textSize="16sp"
        android:ellipsize="marquee"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/nodeIconBlock"
        android:text="@string/default_itemname" />

    <org.dimensinfin.android.mvc.fonts.ProximaNovaThinTextView
        android:id="@+id/currentLevel"
        style="@style/AppTheme.SkillLevel"
        android:layout_alignParentTop="true"
        android:layout_marginRight="@dimen/uirighttextmargin"
        android:layout_centerVertical="true"
        android:layout_marginTop="1dp"
        android:layout_toLeftOf="@+id/skillLevelsGroup"
        android:text="Level 3"
        android:visibility="visible" />

    <org.dimensinfin.android.mvc.fonts.ProximaNovaRegularTextView
        android:id="@+id/trainingCompleted"
        style="@style/AppTheme.SkillLevel"
        android:layout_below="@+id/currentLevel"
        android:layout_marginRight="@dimen/standardmargin"
        android:layout_toLeftOf="@+id/inTrainingProgressBlock"
        android:text="0% done"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/skillLevelsGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginTop="@dimen/standardmargin"
        android:visibility="visible"
        android:layout_toLeftOf="@+id/rightBlock"
        android:background="@drawable/whiteborderbox"
        android:orientation="horizontal"
        android:padding="1dp">

        <ImageView
            android:id="@+id/skillLevel1"
            style="@style/AppTheme.SkillBlock"
            android:layout_marginLeft="2dp"
            android:background="@drawable/skillcompleted"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/skillLevel2"
            style="@style/AppTheme.SkillBlock"
            android:background="@drawable/skillcompleted"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/skillLevel3"
            style="@style/AppTheme.SkillBlock"
            android:background="@drawable/skilltraining"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/skillLevel4"
            style="@style/AppTheme.SkillBlock"
            android:background="@drawable/skillpending"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/skillLevel5"
            style="@style/AppTheme.SkillBlock"
            android:background="@drawable/skillempty"
            android:visibility="visible" />
    </LinearLayout>

</RelativeLayout>