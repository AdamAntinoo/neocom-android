<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panelborderred">

    <ImageView
        android:id="@+id/nodeIcon"
        style="@style/AppTheme.ItemIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/nopilot" />

    <ImageView
        android:id="@+id/rightArrow"
        style="@style/AppTheme.Arrow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentRight="true" />

    <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
        android:id="@+id/name"
        style="@style/AppTheme.TextView"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/nodeIcon"
        android:text="@string/default_loginname"
        android:textColor="@color/appgreen"
        android:textSize="16sp" />

    <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
        android:id="@+id/titleLabel"
        style="@style/AppTheme.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/rightArrow"
        android:singleLine="true"
        android:text="LOGIN"
        android:textSize="9sp" />

    <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
        android:id="@+id/childCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titleLabel"
        android:layout_toLeftOf="@+id/rightArrow"
        android:gravity="right"
        android:text="320"
        android:textColor="@android:color/white"
        android:textSize="14dp" />

    <TextView
        android:id="@+id/locationLabel"
        style="@style/AppTheme.Label"
        android:layout_width="wrap_content"
        android:layout_below="@+id/childCount"
        android:layout_toLeftOf="@+id/rightArrow"
        android:gravity="right"
        android:text="CHARACTERS" />

</RelativeLayout>
