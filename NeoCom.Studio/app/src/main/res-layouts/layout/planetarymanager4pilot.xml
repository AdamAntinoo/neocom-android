<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panelplanetary">

    <include layout="@layout/nodebase4list" />

    <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
        android:id="@+id/name"
        style="@style/AppTheme.NeoComText.Orange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/nodeIcon"
        android:text="@string/default_managername"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/resourceCountBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_gravity="right"
        android:layout_marginRight="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/countLabel"
            style="@style/AppTheme.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:text="RESOURCE COUNT:" />

        <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
            android:id="@+id/resourceCount"
            style="@style/AppTheme.StockCounter"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp" />
    </LinearLayout>
</RelativeLayout>
