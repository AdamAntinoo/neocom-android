<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panelplanetary" >

    <include layout="@layout/nodebase4list" />

    <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
        android:id="@+id/name"
        style="@style/AppTheme.NeoComText.Orange"
        android:layout_width="wrap_content"
        android:layout_centerVertical="true"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_toRightOf="@+id/nodeIcon"
        android:text="@string/default_managername" />

    <LinearLayout
        android:id="@+id/leftBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_gravity="right"
        android:layout_marginRight="2dp"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@+id/assetCountBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/countLabel"
                style="@style/AppTheme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text="NO. ASSETS:" />

            <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
                android:id="@+id/managerAssetsCount"
                style="@style/AppTheme.StockCounter"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/regionCountBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/regionCountLabel"
                style="@style/AppTheme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text="NO. REGIONS:" />

            <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
                android:id="@+id/managerRegionCount"
                style="@style/AppTheme.StockCounter"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
