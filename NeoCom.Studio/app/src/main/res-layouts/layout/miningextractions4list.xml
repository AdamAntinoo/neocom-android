<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/uipanelborderpurple">

    <ImageView
        android:id="@+id/nodeIcon"
        style="@style/AppTheme.NodeIcon"
        android:layout_width="@dimen/nodeiconsize"
        android:layout_height="@dimen/nodeiconsize"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:src="@drawable/defaulticonplaceholder" />

    <ImageView
        android:id="@+id/separator"
        android:layout_width="@dimen/standardleftseparation"
        android:layout_height="1dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/rightArrow"
        android:src="@android:color/transparent"
        android:visibility="visible" />

    <org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
        android:id="@+id/instructionsLabel"
        android:layout_height="wrap_content"
        style="@style/AppTheme.TextView"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/nodeIcon"
        android:text="@string/default_itemname"
        android:singleLine="true"
        android:textSize="14sp" />

</RelativeLayout>
