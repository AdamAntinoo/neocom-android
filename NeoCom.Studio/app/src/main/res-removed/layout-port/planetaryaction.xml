<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panelborderyellow"
    android:orientation="horizontal" >

    <LinearLayout
        android:id="@+id/inputsBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        android:layout_weight="0.5"
        android:background="@drawable/whiteborderbox"
        android:orientation="vertical" >

        <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
            android:id="@+id/inputsLabel"
            style="@style/Label.Style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INPUTS"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/inputsValueBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
                android:id="@+id/inputsValueLabel"
                style="@style/Label.Style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISK VALUE:"
                android:textSize="10sp" />

            <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
                android:id="@+id/inputsValueTotal"
                style="@style/Name.Selectable.12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,420 ISK"
                android:textColor="@color/appwhite"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/inputsResourcesList"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/outputsBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_weight="0.5"
        android:background="@drawable/whiteborderbox"
        android:orientation="vertical" >

        <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
            android:id="@+id/outputsLabel"
            style="@style/Label.Style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUTPUTS"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/outputsValueBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
                android:id="@+id/outputsValueLabel"
                style="@style/Label.Style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISK VALUE:"
                android:textSize="10sp" />

            <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
                android:id="@+id/outputsValueTotal"
                style="@style/Name.Selectable.12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,420 ISK"
                android:textColor="@color/appwhite"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/outputsResourcesList"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >
        </LinearLayout>
    </LinearLayout>

</LinearLayout>