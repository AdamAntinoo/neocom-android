<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background="@drawable/panelplanetary">

    <FrameLayout
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/pilotAvatar"
            android:layout_width="fill_parent"
            android:layout_height="200dp"
            android:layout_margin="2dp"
            android:contentDescription="Character avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/nopilot" />

        <RelativeLayout
            android:id="@+id/midLeftBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|left"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cloneIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentLeft="true"
                android:contentDescription="Clone Type Icon"
                android:src="@drawable/omega" />

            <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
                android:id="@+id/pilotName"
                style="@style/AppTheme.TextView.Glow.White"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_margin="0dp"
                android:padding="0dp"
                android:layout_toRightOf="@+id/cloneIcon"
                 android:text="Adam Antinoo"
                android:textSize="16sp" />

            <org.dimensinfin.android.mvc.fonts.Din1451TextView
                android:id="@+id/characterId"
                style="@style/AppTheme.TextView"
                android:layout_toRightOf="@+id/cloneIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pilotName"
                 android:text="[9863234]"
                android:textSize="12sp" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/midRightBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/raceIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Clone Type Icon"
                android:src="@drawable/minmatar" />

            <ImageView
                android:id="@+id/corporationIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Clone Type Icon"
                android:src="@drawable/omega"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomLeftBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_marginBottom="6dp"
            android:layout_marginLeft="3dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cloneBlockIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Cloner Marker place"
                android:src="@drawable/medical" />

            <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
                android:id="@+id/lastKnownLocation"
                style="@style/AppTheme.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:text="The Forge > Japeto > Carthum Comglometary Station 0.4"
                android:textSize="11sp" />
        </LinearLayout>

        <org.dimensinfin.android.mvc.fonts.Din1451EngTextView
            android:id="@+id/accountBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_marginBottom="6dp"
            android:layout_marginRight="3dp"
            android:text="123,345,556.98 ISK"
            android:textColor="@android:color/white"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pilotInformationBlock"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_below="@+id/headerBackground"
        android:background="@color/uipaneldataareabackground"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/assetsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/assetsIcon"
                style="@style/AppTheme.NodeIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentLeft="true"
                android:contentDescription="Cloner Marker place"
                android:src="@drawable/assets" />

            <org.dimensinfin.android.mvc.fonts.Din1451TextView
                android:id="@+id/assetsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:layout_alignParentRight="true"
                android:layout_gravity="right"
                android:text="125 items"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/assetsCountLabel"
            style="@style/AppTheme.Label.TopLine"
            android:text="ASSET COUNT" />

        <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
            android:id="@+id/race"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="Minmatar"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:visibility="gone" />

        <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
            android:id="@+id/skillPointsBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="123,345,556.98 Skill Points"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lastKnownLocation2"
            style="@style/AppTheme.TextView"
            android:singleLine="false"
            android:text=">>> Goni VII - Transtellar Shipping"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lastKnownLocationLabel"
            style="@style/AppTheme.Label"
            android:layout_width="fill_parent"
            android:background="@drawable/topwhiteline"
            android:text="LAST KNOWN LOCATION"
            android:visibility="gone" />


        <TextView
            android:id="@+id/accountBalanceLabel"
            style="@style/AppTheme.Label.TopLine"
            android:gravity="left"
            android:text="BALANCE"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
