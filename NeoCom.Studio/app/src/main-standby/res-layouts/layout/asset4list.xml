<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:background="@drawable/uipanelborderyellow">

        <include layout="@layout/nodebase4list" />

        <RelativeLayout
            android:id="@+id/pilotInformationBlock"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_toLeftOf="@+id/separator"
            android:layout_toRightOf="@+id/nodeIcon"
            android:orientation="vertical">

            <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
                android:id="@+id/assetName"
                style="@style/AppTheme.NeoComText.Green"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:text="@string/default_bponame" />

            <org.dimensinfin.android.mvc.fonts.Din1451EngTextView
                android:id="@+id/assetCategory"
                style="@style/AppTheme.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_below="@+id/assetName"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:text="Mineral - Asteroid"
                android:textColor="@color/appwhite"
                android:textSize="12sp" />

            <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
                android:id="@+id/itemPrice"
                style="@style/AppTheme.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_below="@+id/assetCategory"
                android:layout_toLeftOf="@+id/stackValue"
                android:ellipsize="marquee"
                android:gravity="left"
                android:text="123,456.65 ISK"
                android:textColor="@color/appwhite"
                android:textSize="12sp"
                android:visibility="visible" />

            <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
                android:id="@+id/stackValue"
                style="@style/AppTheme.TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_below="@+id/assetCategory"
                android:ellipsize="marquee"
                android:gravity="right"
                android:singleLine="true"
                android:text="123,456.65 ISK"
                android:textColor="@color/appwhite"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/valueLabel"
                style="@style/AppTheme.Label.TopLine"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_below="@+id/stackValue"
                android:gravity="right"
                android:text="STACK VALUE" />

            <LinearLayout
                android:id="@+id/qtyBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:orientation="vertical">

                <org.dimensinfin.android.mvc.fonts.MonsOlympiaBoldTextView
                    android:id="@+id/count"
                    style="@style/AppTheme.StockCounter"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="@string/default_smallnumber"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/countLabel"
                    style="@style/AppTheme.Label"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:gravity="right"
                    android:singleLine="true"
                    android:text="STACK SIZE" />
            </LinearLayout>
        </RelativeLayout>

    </RelativeLayout>
</LinearLayout>
