<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panelbordergreen">

    <include layout="@layout/nodebase4list" />

    <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
        android:id="@+id/name"
        style="@style/AppTheme.NeoComText.Orange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/nodeIcon"
        android:text="@string/default_managername"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/resourceCountBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_gravity="right"
        android:layout_marginRight="2dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/blubprintT1Block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bpT1Label"
                style="@style/AppTheme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text="T1 BP CPUNT:" />

            <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
                android:id="@+id/t1BueprintCount"
                style="@style/AppTheme.StockCounter"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/blubprintT2Block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/bpT2Label"
                style="@style/AppTheme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text="T2 BP COUNT:" />

            <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
                android:id="@+id/t2BueprintCount"
                style="@style/AppTheme.StockCounter"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/blueprintT3Block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bpT3Label"
                style="@style/AppTheme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text="T3 BP COUNT:" />

            <org.dimensinfin.android.mvc.fonts.MonsOlympiaTextView
                android:id="@+id/t3BueprintCount"
                style="@style/AppTheme.StockCounter"
                android:layout_width="fill_parent"
                android:text="--"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
