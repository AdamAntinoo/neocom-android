<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panelborderyellow" >

    <ImageView
        android:id="@+id/itemIcon"
        style="@style/ItemIconStyle.Size32"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_margin="2dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/whiteborderbox"
        android:contentDescription="Item Icon"
        android:src="@drawable/nopilot"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/separator"
        android:layout_width="10dp"
        android:layout_height="1dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/rightArrow"
        android:src="@color/panelbackgroundblack"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/rightArrow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_gravity="right"
        android:gravity="right"
        android:padding="-4dp"
        android:src="@drawable/arrowdown"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/resourceBlock"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/resourceValue"
        android:layout_toRightOf="@+id/itemIcon" >

        <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
            android:id="@+id/resourceName"
            style="@style/Name.Selectable.12"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:text="Plasmoids"
            android:textColor="@color/apporangemedium" />

        <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
            android:id="@+id/resourceQuantity"
            style="@style/Name.Style.12"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/resourceName"
            android:layout_gravity="left"
            android:text="1,420"
            android:textColor="@color/appwhite" />

        <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
            android:id="@+id/resourcePrice"
            style="@style/Name.Style.12"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/resourceName"
            android:text="13 ISK"
            android:textColor="@color/appwhite" />
         <TextView
            android:id="@+id/resourceQuantityLabel"
            style="@style/Label.Style"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/resourceQuantity"
            android:text="QUANTITY" />
         <TextView
            android:id="@+id/resourcePriceLabel"
            style="@style/Label.Style"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/resourcePrice"
            android:text="PRICE" />
         </RelativeLayout>

    <LinearLayout
        android:id="@+id/resourceValueBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="3dp"
        android:gravity="right"
        android:orientation="vertical" >

        <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
            android:id="@+id/resourceTotalValue"
            style="@style/PriceStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13,420" />

        <org.dimensinfin.eveonline.neocom.core.MonsOlympiaBold
            android:id="@+id/resourceTotalValueLabel"
            style="@style/Label.Style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MARKET VALUE" />
    </LinearLayout>

</RelativeLayout>