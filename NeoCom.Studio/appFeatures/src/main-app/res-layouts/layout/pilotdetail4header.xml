<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/uipanelborderdarkblue">

    <FrameLayout
        android:id="@+id/nodeIconBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="false">

        <ImageView
            android:id="@+id/avatarIcon"
            style="@style/AppTheme.NodeIcon"
            android:layout_width="@dimen/nodeiconsizebig"
            android:layout_height="@dimen/nodeiconsizebig"
            android:src="@drawable/nopilot" />

        <ImageView
            android:id="@+id/corporationIconSmall"
            android:layout_width="@dimen/nodeiconsizecomplementary"
            android:layout_height="@dimen/nodeiconsizecomplementary"
            android:layout_gravity="left|top"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="0dp"
            android:src="@drawable/xml_icon"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/allianceIconSmall"
            android:layout_width="@dimen/nodeiconsizecomplementary"
            android:layout_height="@dimen/nodeiconsizecomplementary"
            android:layout_gravity="right|top"
            android:layout_marginTop="2dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/defaulticonplaceholder"
            android:visibility="gone" />


        <ImageView
            android:id="@+id/raceIconSmall"
            android:layout_width="@dimen/nodeiconsizecomplementary"
            android:layout_height="@dimen/nodeiconsizecomplementary"
            android:layout_gravity="right|bottom"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/amarr"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/cloneIconSmall"
            android:layout_width="@dimen/nodeiconsizecomplementary"
            android:layout_height="@dimen/nodeiconsizecomplementary"
            android:layout_gravity="left|bottom"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/omega"
            android:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/corporationDataBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/pilotInformationBlock"
        android:layout_toRightOf="@+id/nodeIconBlock"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/corporationIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/defaulticonplaceholder" />

        <org.dimensinfin.android.mvc.fonts.Din1451TextView
            android:id="@+id/corporationName"
            style="@style/AppTheme.NeoComText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/standardmargin"
            android:text="@string/default_name"
            android:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/allianceDataBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/corporationDataBlock"
        android:layout_toRightOf="@+id/nodeIconBlock"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/allianceIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@+id/pilotInformationBlock"
            android:layout_alignParentTop="false"
            android:layout_toRightOf="@+id/nodeIconBlock"
            android:src="@drawable/defaulticonplaceholder" />

        <org.dimensinfin.android.mvc.fonts.Din1451TextView
            android:id="@+id/allianceName"
            style="@style/AppTheme.NeoComText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/standardmargin"
            android:text="@string/default_name"
            android:visibility="visible" />
    </LinearLayout>


    <ImageView
        android:id="@+id/raceIcon"
        android:layout_width="@dimen/nodeiconsize"
        android:layout_height="@dimen/nodeiconsize"
        android:layout_below="@+id/corporationIcon"
        android:layout_toRightOf="@+id/nodeIconBlock"
        android:src="@drawable/defaulticonplaceholder"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pilotInformationBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@+id/nodeIconBlock"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/pilotNameBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
                android:id="@+id/pilotName"
                style="@style/AppTheme.NeoComText"
                android:text="Adam Antinoo" />

            <org.dimensinfin.android.mvc.fonts.ProximaNovaThinTextView
                android:id="@+id/pilotIdentifier"
                style="@style/AppTheme.NeoComText.Identifier"
                android:layout_marginLeft="4dp"
                android:text="[60014089]" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/pilotWalletDataBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/nodeIconBlock"
        android:layout_alignParentLeft="true"
        android:orientation="vertical"
        android:visibility="gone">

        <org.dimensinfin.android.mvc.fonts.PrototypeTextView
            android:id="@+id/accountBalance"
            style="@style/AppTheme.NeoComText.Pilot.Amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:text="123,345,556.98 ISK"
            android:visibility="visible" />

        <TextView
            android:id="@+id/accountBalanceLabel"
            style="@style/AppTheme.Label.TopLine"
            android:layout_alignParentLeft="true"
            android:gravity="left"
            android:text="BALANCE" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pilotSkillPointsBlock"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/nodeIconBlock"
        android:layout_marginLeft="@dimen/standardmargin"
        android:layout_marginRight="@dimen/standardmargin"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/skillsIcon"
            style="@style/AppTheme.NodeIcon"
            android:layout_width="@dimen/nodeiconsizesmall"
            android:layout_height="@dimen/nodeiconsizesmall"
            android:layout_alignParentLeft="true"
            android:src="@drawable/skills"
            android:visibility="visible" />

        <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
            android:id="@+id/skillsTitle"
            style="@style/AppTheme.NeoComText.Pilot.Amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/standardmargin"
            android:layout_toRightOf="@+id/skillsIcon"
            android:text="SKILLS"
            android:visibility="visible" />

        <org.dimensinfin.android.mvc.fonts.PrototypeTextView
            android:id="@+id/skillPoints"
            style="@style/AppTheme.NeoComText.Pilot.Amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:gravity="right"
            android:text="@string/default_skillpoints"
            android:visibility="visible" />

        <TextView
            android:id="@+id/skillPointsLabel"
            style="@style/AppTheme.Label.TopLine"
            android:layout_below="@+id/skillsIcon"
            android:layout_alignParentRight="true"
            android:gravity="right"
            android:text="SKILL POINTS" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/pilotRaceBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:gravity="right"
        android:orientation="vertical"
        android:visibility="visible">

        <org.dimensinfin.android.mvc.fonts.ElementalEndTextView
            android:id="@+id/nodeClass"
            style="@style/AppTheme.NodeClass"
            android:layout_alignParentRight="true"
            android:gravity="right"
            android:text="PILOT"
            android:textColor="@color/appwhite" />

        <LinearLayout
            android:id="@+id/pilotRaceDetailBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:gravity="right"
            android:orientation="horizontal"
            android:visibility="visible">

            <ImageView
                android:id="@+id/raceIconName"
                style="@style/AppTheme.NodeIcon"
                android:layout_width="@dimen/nodeiconsizesmall"
                android:layout_height="@dimen/nodeiconsizesmall"
                android:src="@drawable/defaulticonplaceholder"
                android:visibility="visible" />

            <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
                android:id="@+id/raceName"
                style="@style/AppTheme.TextView"
                android:layout_marginTop="3dp"
                android:gravity="right"
                android:text="Minmatar"
                android:textColor="@color/appgreylight"
                android:textSize="11sp" />
        </LinearLayout>

        <org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
            android:id="@+id/cloneType"
            style="@style/AppTheme.TextView"
            android:layout_alignParentRight="true"
            android:layout_marginTop="-4dp"
            android:gravity="right"
            android:singleLine="false"
            android:text="Clone Grade Alpha"
            android:textColor="@color/apporangemedium"
            android:textSize="11sp" />

        <org.dimensinfin.android.mvc.fonts.ProximaNovaRegularTextView
            android:id="@+id/expirationTime"
            style="@style/AppTheme.TextView"
            android:layout_alignParentRight="true"
            android:layout_marginTop="-4dp"
            android:gravity="right"
            android:singleLine="false"
            android:text="Expired"
            android:textColor="@color/appred"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>
