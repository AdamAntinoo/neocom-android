<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical">

	<RelativeLayout
			android:id="@+id/nodeContainer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/uipanelborderred">

		<include layout="@layout/nodebase4expandnew"/>

		<org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
				android:id="@+id/facilityName"
				style="@style/AppTheme.NeoComText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_alignParentTop="true"
				android:layout_toRightOf="@+id/nodeIconBlock"
				android:text="Command Center"
				android:textSize="14sp"
				android:textStyle="bold"/>

		<RelativeLayout
				android:id="@+id/extractingBlock"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_below="@+id/facilityName"
				android:layout_toRightOf="@+id/nodeIconBlock">

			<ImageView
					android:id="@+id/extractingResourceIcon"
					style="@style/AppTheme.NodeIcon"
					android:layout_width="@dimen/nodeiconsizesmall"
					android:layout_height="@dimen/nodeiconsizesmall"
					android:src="@drawable/defaulticonplaceholder"
					android:layout_alignParentLeft="true"
					android:layout_alignParentTop="true"
					android:visibility="visible"/>

			<org.dimensinfin.android.mvc.fonts.Din1451TextView
					android:id="@+id/extractingLabel"
					style="@style/AppTheme.Label.Big"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_alignParentTop="true"
					android:layout_toRightOf="@+id/extractingResourceIcon"
					android:text="Extracting"
					android:visibility="visible"/>

			<org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
					android:id="@+id/extractingResourceName"
					style="@style/AppTheme.Label.Big"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_toRightOf="@+id/extractingResourceIcon"
					android:layout_below="@+id/extractingLabel"
					android:text="@string/default_resource"
					android:visibility="visible"/>
		</RelativeLayout>

		<RelativeLayout
				android:id="@+id/currentCycleBlock"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_below="@+id/facilityName"
				android:layout_toLeftOf="@+id/rightBlock"
				android:layout_marginLeft="10dp"
				android:layout_toRightOf="@+id/extractingBlock">


			<org.dimensinfin.android.mvc.fonts.Din1451TextView
					android:id="@+id/currentCycleLabel"
					style="@style/AppTheme.Label.Big"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_alignParentTop="true"
					android:text="Current cycle"
					android:visibility="visible"/>

			<ProgressBar
					android:id="@+id/currentCycleProgress"
					style="?android:attr/progressBarStyleHorizontal"
					android:layout_width="match_parent"
					android:layout_height="8dp"
					android:layout_centerVertical="true"
					android:layout_toLeftOf="@+id/rightBlock"
					android:layout_below="@+id/currentCycleLabel"
					android:backgroundTint="@color/uipanelborder"
					android:max="100"
					android:min="0"
					android:progress="35"
					android:progressTint="@color/appwhite"/>

			<org.dimensinfin.android.mvc.fonts.Din1451BoldTextView
					android:id="@+id/currentCycleTime"
					style="@style/AppTheme.Label.Big"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_below="@+id/currentCycleProgress"
					android:text="@string/default_time"
					android:visibility="visible"/>
		</RelativeLayout>

		<LinearLayout
				android:id="@+id/currentCycleBlock2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:visibility="gone"
				android:layout_below="@+id/spaceUsageBlock"
				android:layout_toLeftOf="@+id/rightBlock"
				android:weightSum="100">

			<LinearLayout
					android:id="@+id/cpuContentsBlock"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_alignParentTop="true"
					android:layout_marginRight="2dp"
					android:layout_weight="50"
					android:visibility="gone"
					android:orientation="vertical">

				<TextView
						android:id="@+id/cpuLevel"
						style="@style/AppTheme.Label"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentLeft="true"
						android:layout_centerVertical="true"
						android:layout_marginRight="@dimen/uirighttextmargin"
						android:text="CPU: 37%"
						android:textSize="10dp"
						android:visibility="visible"/>

				<ProgressBar
						android:id="@+id/cpuProgress"
						style="?android:attr/progressBarStyleHorizontal"
						android:layout_width="match_parent"
						android:layout_height="8dp"
						android:layout_centerVertical="true"
						android:layout_toLeftOf="@+id/fillLevelNumber"
						android:layout_toRightOf="@+id/fillLevelLabel"
						android:backgroundTint="@color/uipanelborder"
						android:max="100"
						android:min="0"
						android:progress="35"
						android:progressTint="@color/appbluelight"/>

				<TextView
						android:id="@+id/cpuLevelData"
						style="@style/AppTheme.Label"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentLeft="true"
						android:layout_centerVertical="true"
						android:layout_marginRight="@dimen/uirighttextmargin"
						android:text="7.934/21.315 tf"
						android:textSize="10dp"
						android:visibility="visible"/>

			</LinearLayout>

			<LinearLayout
					android:id="@+id/powerContentsBlock"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_alignParentTop="true"
					android:layout_marginLeft="2dp"
					android:layout_weight="50"
					android:visibility="gone"
					android:orientation="vertical">

				<TextView
						android:id="@+id/powerLevel"
						style="@style/AppTheme.Label"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentLeft="true"
						android:layout_centerVertical="true"
						android:layout_marginRight="@dimen/uirighttextmargin"
						android:text="Power: 96.01%"
						android:textSize="10dp"
						android:visibility="visible"/>

				<ProgressBar
						android:id="@+id/powerProgress"
						style="?android:attr/progressBarStyleHorizontal"
						android:layout_width="match_parent"
						android:layout_height="8dp"
						android:layout_centerVertical="true"
						android:layout_toLeftOf="@+id/fillLevelNumber"
						android:layout_toRightOf="@+id/fillLevelLabel"
						android:backgroundTint="@color/uipanelborder"
						android:max="100"
						android:min="0"
						android:progress="35"
						android:progressTint="@color/appred"/>

				<TextView
						android:id="@+id/powerLevelData"
						style="@style/AppTheme.Label"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentLeft="true"
						android:layout_centerVertical="true"
						android:layout_marginRight="@dimen/uirighttextmargin"
						android:text="16,321/117,000 M"
						android:textSize="10dp"
						android:visibility="visible"/>

			</LinearLayout>
		</LinearLayout>

		<TextView
				android:id="@+id/installationsLabel"
				style="@style/AppTheme.TextView"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_below="@+id/structureType"
				android:layout_marginRight="2dp"
				android:layout_toRightOf="@+id/nodeIconBlock"
				android:text="Number of Structures:"
				android:textSize="10sp"
				android:visibility="gone"/>

		<TextView
				android:id="@+id/installationsNumber"
				style="@style/AppTheme.TextView"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_centerVertical="true"
				android:layout_toLeftOf="@+id/rightBlock"
				android:gravity="right"
				android:text="11"
				android:textSize="14sp"
				android:textStyle="bold"
				android:visibility="gone"/>
	</RelativeLayout>
</LinearLayout>
