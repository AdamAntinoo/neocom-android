<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/blacktraslucent80">

    <org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
        android:id="@+id/title"
        style="@style/AppTheme.NeoComText"
        android:layout_gravity="left|center"
        android:layout_marginLeft="@dimen/standardmargin"
        android:text="@string/default_paneltitle" />

    <org.dimensinfin.android.mvc.fonts.ProximaNovaThinTextView
        android:id="@+id/contentsVolume"
        style="@style/AppTheme.NeoComText"
        android:layout_gravity="center|center"
        android:layout_marginLeft="35dp"
        android:text="@string/default_volume"
        android:textSize="14sp" />

    <org.dimensinfin.android.mvc.fonts.ProximaNovaThinTextView
        android:id="@+id/contentsValue"
        style="@style/AppTheme.NeoComText"
        android:layout_gravity="right|center"
        android:layout_marginRight="@dimen/standardmargin"
        android:text="@string/default_isk"
        android:textSize="14sp" />
</FrameLayout>
