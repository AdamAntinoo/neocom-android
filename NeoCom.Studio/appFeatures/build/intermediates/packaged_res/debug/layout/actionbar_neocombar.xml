<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/activityIcon"
        style="@style/AppTheme.ActionBarActivityIcon"
        android:layout_width="@dimen/nodeiconsize"
        android:layout_height="@dimen/nodeiconsize"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:src="@drawable/defaulticonplaceholder" />

    <ImageView
        android:id="@+id/upperIcon"
        style="@style/AppTheme.ActionBarComplementaryIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@+id/activityIcon"
        android:src="@drawable/defaulticonplaceholder" />

    <ImageView
        android:id="@+id/lowerIcon"
        style="@style/AppTheme.ActionBarComplementaryIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_alignParentBottom="true"
        android:layout_toRightOf="@+id/activityIcon"
        android:src="@drawable/defaulticonplaceholder" />

    <org.dimensinfin.android.mvc.fonts.ElementalEndTextView
        android:id="@+id/toolBarTitleLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="4dp"
        android:layout_toRightOf="@+id/upperIcon"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="NEOCOM"
        android:textColor="@color/apporange"
        android:textSize="16sp" />

    <org.dimensinfin.android.mvc.fonts.ProximaNovaBoldTextView
        android:id="@+id/toolBarTitleRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/toolBarTitleLeft"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="3dp"
        android:layout_toRightOf="@+id/toolBarTitleLeft"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="v 1.0.0"
        android:textColor="@color/appyellow"
        android:textSize="12dp" />

    <org.dimensinfin.android.mvc.fonts.ProximaNovaThinTextView
        android:id="@+id/toolBarSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolBarTitleLeft"
        android:layout_marginLeft="3dp"
        android:layout_toRightOf="@+id/upperIcon"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Tranquility: 23.056 capsuleers    ONLINE"
        android:textColor="@color/appgreylight"
        android:textSize="11dp" />
</RelativeLayout>
